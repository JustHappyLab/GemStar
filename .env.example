# Tushare API token (required)
TUSHARE_TOKEN="your_tushare_token_here"

# Anthropic API key (legacy; Claude Code CLI authenticates via `claude` login)
ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# Anthropic API base URL (optional, for proxy users in mainland China)
# ANTHROPIC_BASE_URL="https://your-proxy.com/v1"

# OpenAI API key (legacy; no OpenAI provider is configured by default)
# OPENAI_API_KEY="your_openai_api_key_here"

# SwanLab API key (optional, enables experiment tracking)
SWANLAB_API_KEY="your_swanlab_api_key_here"

# Feishu custom-bot notification (optional)
# FEISHU_WEBHOOK_URL="https://open.feishu.cn/open-apis/bot/v2/hook/your_token"
# FEISHU_WEBHOOK_SECRET="your_custom_bot_signing_secret"

# Optional SwanLab metadata
SWANLAB_PROJ_NAME="gemstar"
# SWANLAB_WORKSPACE="your_team_or_username"
# SWANLAB_EXP_NAME="gemstar-backtest"
